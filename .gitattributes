# 统一换行符，避免 Windows 检出后 gradlew 在 Linux/CI 上出现 bad interpreter
* text=auto eol=lf

# 批处理脚本必须保持 CRLF，否则 Windows 下无法执行
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本与 Wrapper 强制 LF
gradlew text eol=lf
*.sh text eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.jks binary
*.keystore binary
*.zip binary
*.apk binary
