<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PolicyKeeper" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_secondary</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/surface_line</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <item name="colorError">@color/status_expired</item>
        <item name="android:colorBackground">@color/bg_app</item>

        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PolicyKeeper.Dialog</item>
    </style>

    <style name="ThemeOverlay.PolicyKeeper.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_primary</item>
    </style>

    <!-- ==================== 容器 ====================
         圆角体系：卡片 18dp / 控件 14dp，两级清晰不混用 -->
    <style name="Widget.PolicyKeeper.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/surface_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ==================== 文本层级 ====================
         Display 金融式大数字 / SectionTitle 区块标题 / Value 强调值
         Label 字段名 / Caption 补充说明 / Overline 刻度感小标签 -->
    <style name="Text.Display" parent="">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.SectionTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Text.Value" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="Text.Overline" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- ==================== 状态胶囊 ==================== -->
    <style name="Widget.StatusChip" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- ==================== 表单 ==================== -->
    <style name="Widget.PolicyKeeper.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/brand_primary</item>
    </style>

    <style name="Widget.PolicyKeeper.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/brand_primary</item>
    </style>

    <!-- ==================== 按钮 ==================== -->
    <style name="Widget.PolicyKeeper.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.PolicyKeeper.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- ==================== 分段选择器 ====================
         用于「二选一」这类低信息量的选择。把它压成一行 46dp 高，
         而不是两张百来 dp 的大卡片 —— 后者会让次要选项抢走表单的视觉重心 -->
    <style name="Widget.PolicyKeeper.SegmentButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="iconTint">@color/segment_icon</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
        <item name="strokeColor">@color/surface_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ==================== 清单内的小按钮 ====================
         只承担「标记已收」这类单一动作。压到 32dp 高、去掉最小宽度限制，
         否则会把清单行撑得松散 —— 这里是扫读场景，不是表单 -->
    <style name="Widget.PolicyKeeper.MiniButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">10dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ==================== 底部表单 ====================
         表单类交互改用底部弹出：全宽输入框呼吸感更好，键盘弹出时与内容自然贴合 -->
    <style name="Theme.PolicyKeeper.BottomSheet" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.PolicyKeeper.BottomSheet</item>
        <item name="colorPrimary">@color/brand_primary</item>
    </style>

    <style name="Widget.PolicyKeeper.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_sheet</item>
    </style>

    <!-- ==================== 底部导航选中指示器 ==================== -->
    <style name="Widget.PolicyKeeper.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_primary_container</item>
        <item name="android:width">58dp</item>
        <item name="android:height">30dp</item>
    </style>
</resources>
